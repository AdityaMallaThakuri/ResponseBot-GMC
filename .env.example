SMARTLEAD_API_KEY= 
ANTHROPIC_API_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Slack channels, by name or id. Optional for now; each is used by a later step.
SLACK_DRAFT_CHANNEL=
SLACK_LOG_CHANNEL=
SLACK_ALERT_CHANNEL=
SLACK_SHADOW_CHANNEL=
SLACK_OPS_CHANNEL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Never send to real leads unless this is true.
SEND_ENABLED=false
# Writes reply-label categories back to Smartlead. Also requires SEND_ENABLED=true.
CATEGORY_WRITEBACK_ENABLED=false
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Anthropic model ids. Leave blank to use the default (claude-haiku-5-5).
CLASSIFIER_MODEL=
DRAFT_LABEL_MODEL=
# Model confidence below this sends the thread to a human (0 to 1). Blank means 0.75.
CLASSIFIER_MIN_CONFIDENCE=
# not_interested never closes automatically. Below this it goes to human_only; at or above it
# a human sees "suggest: close". Blank means 0.90.
CLASSIFIER_MIN_CONFIDENCE_NOT_INTERESTED=
# Smartlead campaign ids the bot handles, comma separated, for example 101,102.
# Replies from other campaigns are ignored; blank means every reply is ignored.
GMC_CAMPAIGN_IDS=
